{
  "name": "@thorvg/webcanvas",
  "version": "1.1.1",
  "description": "A TypeScript Canvas API for ThorVG with high-performance vector graphics rendering",
  "main": "./dist/webcanvas.cjs.js",
  "module": "./dist/webcanvas.esm.js",
  "types": "./dist/webcanvas.d.ts",
  "exports": {
    ".": {
      "types": "./dist/webcanvas.d.ts",
      "import": "./dist/webcanvas.esm.js",
      "require": "./dist/webcanvas.cjs.js"
    },
    "./thread": {
      "types": "./dist/webcanvas.d.ts",
      "import": "./dist/thread/webcanvas.esm.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "!dist/thorvg.d.ts",
    "!dist/**/thorvg.js"
  ],
  "scripts": {
    "build": "npm run clean && sh ./wasm_wcanvas_setup.sh && THORVG_VERSION=$(npm run version --silent) rollup -c --bundleConfigAsCjs",
    "build:watch": "npm run clean && sh ./wasm_wcanvas_setup.sh && THORVG_VERSION=$(npm run version --silent) rollup -c --bundleConfigAsCjs --watch",
    "clean": "rm -rf dist && mkdir dist && touch dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:sw": "TEST_RENDERER=sw vitest run --config vitest.browser.config.ts",
    "test:gl": "TEST_RENDERER=gl vitest run --config vitest.browser.config.ts",
    "test:wg": "TEST_RENDERER=wg vitest run --config vitest.browser.config.ts",
    "lint": "eslint ./src --ext .ts",
    "lint:fix": "eslint ./src --ext .ts --fix",
    "docs": "typedoc && node ./tools/docs/generate.js",
    "docs:watch": "typedoc --watch",
    "docs:serve": "typedoc --watch --serve",
    "version": "sed -n -e 4p ../../thorvg/meson.build | sed 's/..$//' | sed -r 's/.{19}//'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thorvg/thorvg.web.git",
    "directory": "packages/webcanvas"
  },
  "author": "Jinny You <jinny@lottiefiles.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thorvg/thorvg.web/issues"
  },
  "homepage": "https://thorvg.org",
  "keywords": [
    "thorvg",
    "canvas",
    "vector graphics",
    "webgpu",
    "webgl",
    "wasm",
    "2d graphics"
  ],
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@swc/core": "^1.15.46",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.1",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.0",
    "rollup": "^4.62.3",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-swc3": "^0.12.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
