{
  "name": "thorvg.web",
  "version": "1.0.0",
  "private": true,
  "description": "A WASM-based ThorVG engine for Lottie players and WebCanvas. It enables high-performance graphics through integration with WebGL and WebGPU.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thorvg/thorvg.web.git"
  },
  "author": "Jinny You <jinny@lottiefiles.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thorvg/thorvg.web/issues"
  },
  "homepage": "https://thorvg.org",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
